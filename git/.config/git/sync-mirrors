#!/usr/bin/env bash
# git sync-mirrors [-n] [--prune] [--no-publish] [BRANCH]
#
# Bring every reachable mirror of this repo up to the newest BRANCH,
# fast-forward only.  An unreachable mirror is skipped and reported as
# possibly behind; it is not counted as synced.
#
# Mirrors are the remotes named for a mirror role or host: origin, github,
# mimir, ceridwen, bbgithub.  A repo can set its own list with
#   git config sync-mirrors.remotes "origin forgejo"
# Any other remote (upstream, a person's fork, another project) is never
# fetched, compared or pushed.  Push aliases (a remote with more than one push
# URL, such as `all`) are skipped too.  A repo with fewer than two mirrors has
# nothing to sync and is left alone.
#
# BRANCH defaults to the branch origin/HEAD names, else a bare repo's HEAD,
# else main.
#
# If the tips of BRANCH have truly diverged (no single tip contains the
# others), nothing is pushed: that needs a merge by hand.
#
# The local BRANCH is fast-forwarded too, in whichever worktree has it checked
# out, so this works from a bare repo or any of its linked worktrees.
#
# Branches on a mirror that are already merged into BRANCH are listed; with
# --prune they are deleted from that mirror.  A branch sitting exactly at the
# tip of BRANCH is never counted as merged; it may be new work.
#
#   -n            dry run: fetch and report, change nothing
#   --prune       delete merged branches from the mirrors
#   --no-publish  push only commits some mirror already has; local commits on
#                 no mirror are reported, not pushed.  For sweeps over many
#                 repos.

set -uo pipefail

dry_run=false
prune=false
publish=true
branch=
while (($#)); do
    case "$1" in
        -n|--dry-run) dry_run=true ;;
        --prune)      prune=true ;;
        --no-publish) publish=false ;;
        -h|--help)    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        -*)           echo "sync-mirrors: unknown option $1" >&2; exit 2 ;;
        *)            branch="$1" ;;
    esac
    shift
done

export GIT_TERMINAL_PROMPT=0

run() {
    if $dry_run; then echo "  would run: git $*"; else git "$@"; fi
}

names=$(git config --get sync-mirrors.remotes || echo "origin github mimir ceridwen bbgithub")
mirrors=()
for r in $(git remote); do
    [[ " $names " == *" $r "* ]] || continue
    n=$(git config --get-all "remote.$r.pushurl" | wc -l)
    ((n > 1)) && continue
    mirrors+=("$r")
done

if ((${#mirrors[@]} < 2)); then
    echo "fewer than two mirrors (${mirrors[*]:-none}); nothing to sync"
    exit 0
fi

reachable=()
unreachable=()
declare -A why
for r in "${mirrors[@]}"; do
    if err=$(timeout 30 git fetch --prune --quiet "$r" 2>&1); then
        reachable+=("$r")
    else
        unreachable+=("$r")
        why[$r]=$(printf '%s\n' "$err" | grep -m1 . || echo "fetch timed out")
    fi
done

if ((${#reachable[@]} == 0)); then
    echo "sync-mirrors: no mirror reachable" >&2
    for r in "${unreachable[@]}"; do echo "  $r: ${why[$r]}" >&2; done
    exit 1
fi

if [[ -z $branch ]]; then
    branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    branch=${branch#origin/}
    if [[ -z $branch && $(git rev-parse --is-bare-repository) == true ]]; then
        branch=$(git symbolic-ref --quiet --short HEAD)
    fi
    branch=${branch:-main}
fi

# Candidate tips: each reachable mirror's copy of the branch, and the local
# branch unless only commits already on a mirror may be pushed.
declare -A tipof
refs=()
local_ref="refs/heads/$branch"
has_local=false
if git rev-parse --verify --quiet "$local_ref" >/dev/null; then
    has_local=true
    tipof[$local_ref]=$(git rev-parse "$local_ref")
    $publish && refs+=("$local_ref")
fi
for r in "${reachable[@]}"; do
    ref="refs/remotes/$r/$branch"
    if git rev-parse --verify --quiet "$ref" >/dev/null; then
        refs+=("$ref")
        tipof[$ref]=$(git rev-parse "$ref")
    fi
done

if ((${#refs[@]} == 0)); then
    echo "no $branch on any reachable mirror; nothing to sync"
    exit 0
fi

# The newest tip is one that every other candidate is an ancestor of.
tip=
for a in "${refs[@]}"; do
    ok=true
    for b in "${refs[@]}"; do
        git merge-base --is-ancestor "${tipof[$b]}" "${tipof[$a]}" || { ok=false; break; }
    done
    if $ok; then tip=${tipof[$a]}; break; fi
done

if [[ -z $tip ]]; then
    echo "sync-mirrors: $branch has diverged; merge by hand. Tips:" >&2
    for ref in "${refs[@]}"; do
        printf '  %-32s %s\n' "$ref" "$(git log -1 --format='%h %cs %s' "$ref")" >&2
    done
    exit 1
fi

echo "$branch -> $(git log -1 --format='%h %s' "$tip")"
status=0

for r in "${reachable[@]}"; do
    ref="refs/remotes/$r/$branch"
    if [[ ${tipof[$ref]:-} == "$tip" ]]; then
        echo "$r: up to date"
    else
        echo "$r: behind, pushing"
        run push --quiet "$r" "$tip:refs/heads/$branch" || status=1
    fi
done

# Local branch.  Without --no-publish it is one of the candidates, so it is
# either the tip or behind it; with it, it may also be ahead or diverged.
if $has_local && [[ ${tipof[$local_ref]} != "$tip" ]]; then
    lsha=${tipof[$local_ref]}
    if git merge-base --is-ancestor "$lsha" "$tip"; then
        # The worktree that has the branch checked out, if any.  Moving the
        # ref under it with update-ref would leave its files out of step.
        wt=$(git worktree list --porcelain |
             awk -v want="branch $local_ref" '/^worktree /{w=substr($0,10)} $0==want{print w; exit}')
        if [[ -n $wt ]]; then
            echo "local $branch: behind, fast-forwarding in $wt"
            # A git alias runs with GIT_DIR (and maybe GIT_WORK_TREE) exported
            # for the repo it was started in; left set, they would point this
            # merge at the caller's git dir rather than $wt's.
            if $dry_run; then
                echo "  would run: git -C $wt merge --ff-only $tip"
            else
                (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
                 git -C "$wt" merge --ff-only --quiet "$tip") || status=1
            fi
        else
            echo "local $branch: behind, updating"
            run update-ref "$local_ref" "$tip" "$lsha" || status=1
        fi
    elif git merge-base --is-ancestor "$tip" "$lsha"; then
        echo "local $branch: $(git rev-list --count "$tip..$lsha") commit(s) on no mirror; not published (--no-publish)"
    else
        echo "local $branch: diverged from the mirrors; left alone"
        status=1
    fi
fi

for r in "${reachable[@]}"; do
    merged=()
    while read -r ref; do
        name=${ref#refs/remotes/$r/}
        [[ $name == "$branch" || $name == HEAD ]] && continue
        sha=$(git rev-parse "$ref")
        [[ $sha == "$tip" ]] && continue
        git merge-base --is-ancestor "$sha" "$tip" && merged+=("$name")
    done < <(git for-each-ref --format='%(refname)' "refs/remotes/$r/")
    ((${#merged[@]})) || continue
    if $prune; then
        echo "$r: deleting merged branches: ${merged[*]}"
        run push --quiet "$r" --delete "${merged[@]}" || status=1
    else
        echo "$r: merged into $branch (--prune to delete): ${merged[*]}"
    fi
done

for r in "${unreachable[@]}"; do
    echo "$r: UNREACHABLE, may be behind (${why[$r]})"
done
((${#unreachable[@]})) && status=1

exit $status
