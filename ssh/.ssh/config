# Global fallbacks, kept AFTER the host blocks on purpose.
#
# IdentityFile is cumulative and keys are offered in the order ssh reads
# them, so a global list placed above the host blocks is always tried
# first and a host's own key comes last. That is not merely untidy: a
# server with the usual MaxAuthTries 6 disconnects before ssh reaches key
# seven. panix did exactly that -- id_panix was seventh of seven and was
# never offered, so every connection failed with "Too many authentication
# failures" despite the key being loaded in the agent. IdentitiesOnly=yes
# does not help, because these globals are configured identities too.
IdentityFile ~/.ssh/id_ed25519
IdentityFile ~/.ssh/id_git
IdentityFile ~/.ssh/id_github_kit
IdentityFile ~/.ssh/id_octopus
IdentityFile ~/.ssh/id_openwrt
IdentityFile ~/.ssh/id_rsa
IdentityFile ~/.ssh/id_panix